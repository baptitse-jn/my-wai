# =============================================
# Variables Stripe à configurer sur Vercel
# (NE PAS committer les vraies valeurs)
# =============================================

# Clés Stripe (mode test pour l'instant)
STRIPE_SECRET_KEY=sk_test_...          # Développeurs > Clés API > Secrète
STRIPE_PUBLISHABLE_KEY=pk_test_...    # Développeurs > Clés API > Publiable
STRIPE_WEBHOOK_SECRET=whsec_...       # Développeurs > Webhooks > Signing secret

# Price IDs des 3 offres (Catalogue produits > ID du prix)
STRIPE_PRICE_B2C_49=price_...         # Biographie Essentielle — 49 EUR
STRIPE_PRICE_B2C_99=price_...         # Biographie Premium — 99 EUR
STRIPE_PRICE_B2B_990=price_...        # Pack Entreprise 10 livres — 990 EUR

# Supabase (service_role pour écrire depuis les webhooks)
SUPABASE_SERVICE_KEY=sb_secret_...    # Supabase > Settings > API > service_role

# URL du site (pour les redirections Stripe)
VITE_SITE_URL=https://my-w.ai
