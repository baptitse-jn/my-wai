{
  "redirects": [
    {
      "source": "/contributions/:slug/edit",
      "destination": "https://app.my-w.ai/contributions/:slug/edit",
      "permanent": true
    },
    {
      "source": "/books/:slug/summary",
      "destination": "https://app.my-w.ai/books/:slug/summary",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@4"
    }
  }
}
